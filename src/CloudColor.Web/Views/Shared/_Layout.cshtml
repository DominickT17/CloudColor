@{var rol=User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value;bool ingreso=rol is "Gerente" or "Digitador";string ruta=Context.Request.Path;}
<!DOCTYPE html><html lang="es"><head><meta charset="utf-8"/><link rel="icon" href="/favicon.svg" type="image/svg+xml"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>@ViewData["Title"] · CloudColor</title><link rel="stylesheet" href="/css/site.css" asp-append-version="true"/></head><body>
<a class="skip-link" href="#contenido">Saltar al contenido</a><aside class="sidebar" id="navegacion"><a class="brand" href="/Dashboard"><span class="brand-mark">C</span> CloudColor</a><span class="workspace">GESTIÓN COMERCIAL</span><nav aria-label="Navegación principal">
<a class="nav-link @(ruta=="/Dashboard"?"active":"")" href="/Dashboard"><span aria-hidden="true">▦</span> Inicio</a>
@if(ingreso){
@foreach(var grupo in new[]{("CATÁLOGOS",new[]{("Clientes","Clientes"),("Proveedores","Proveedores"),("Productos","Productos"),("Variantes","Variantes")}), ("INVENTARIO",new[]{("Bodegas","Bodegas"),("Ubicaciones","Ubicaciones"),("Inventario","Inventario")}), ("COMPRAS",new[]{("ProveedorProducto","Proveedor / variante"),("Compras","Órdenes de compra"),("Recepciones","Recepciones")})}){<span class="nav-heading">@grupo.Item1</span>@foreach(var enlace in grupo.Item2){<a class="nav-link @(ruta.StartsWith("/"+enlace.Item1)?"active":"")" href="/@enlace.Item1">@enlace.Item2</a>}}}
<span class="nav-heading">VENTAS</span>@if(ingreso){<a class="nav-link @(ruta.StartsWith("/Cotizaciones")?"active":"")" href="/Cotizaciones">Cotizaciones</a>}<a class="nav-link @(ruta.StartsWith("/Facturas")?"active":"")" href="/Facturas">Facturas</a>@if(rol is "Gerente" or "Cajero"){<a class="nav-link @(ruta.StartsWith("/Cobros")?"active":"")" href="/Cobros">Cobros</a>}
@if(ingreso){<span class="nav-heading">ADMINISTRACIÓN</span><a class="nav-link @(ruta.StartsWith("/Empleados")?"active":"")" href="/Empleados">Empleados</a>}
@if(rol=="Gerente"){<a class="nav-link @(ruta.StartsWith("/Usuarios")?"active":"")" href="/Usuarios">Usuarios</a><a class="nav-link @(ruta.StartsWith("/Roles")?"active":"")" href="/Roles">Roles</a>}
</nav><div class="sidebar-foot"><span class="dot"></span> CloudColor · Sistema de gestión</div></aside><button class="sidebar-backdrop" type="button" aria-label="Cerrar navegación" hidden></button>
<div class="app-shell"><header class="topbar"><button class="menu-toggle" type="button" aria-label="Abrir navegación" aria-controls="navegacion" aria-expanded="false">☰</button><span class="page-context">@ViewData["Title"]</span><button type="button" class="global-search-button" aria-haspopup="dialog" data-open-search>Buscar en CloudColor… <kbd>Alt K</kbd></button><details class="session-menu"><summary><span class="avatar">@(User.Identity?.Name?.FirstOrDefault().ToString().ToUpper()??"C")</span><span><strong>@User.Identity?.Name</strong><small>@rol</small></span></summary><div class="session-panel"><strong>Mi sesión</strong><p>Rol: @rol</p><p class="muted">Los permisos se verifican en cada operación.</p><form method="post" action="/Salir">@Html.AntiForgeryToken()<button class="text-button" type="submit">Salir</button></form></div></details></header><main id="contenido" class="content">
@RenderBody()</main><footer class="app-footer">CloudColor <span>Gestión simple. Información conectada.</span></footer></div>
<partial name="_Overlays"/><script src="/js/site.js" asp-append-version="true" defer></script><script src="/js/ux.js" asp-append-version="true" defer></script><script src="/js/cart.js" asp-append-version="true" defer></script>@await RenderSectionAsync("Scripts",required:false)</body></html>
