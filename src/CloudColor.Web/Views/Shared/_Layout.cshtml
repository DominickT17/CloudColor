@{var rol=User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value;bool ingreso=rol is "Gerente" or "Digitador";string ruta=Context.Request.Path;}
<!DOCTYPE html><html lang="es"><head><meta charset="utf-8"/><link rel="icon" href="/favicon.svg" type="image/svg+xml"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>@ViewData["Title"] · CloudColor</title><link rel="stylesheet" href="/css/site.css" asp-append-version="true"/></head><body>
<a class="skip-link" href="#contenido">Saltar al contenido</a><aside class="sidebar" id="navegacion"><a class="brand" href="/Dashboard"><span class="brand-mark">C</span> CloudColor</a><span class="workspace">GESTIÓN COMERCIAL</span><nav aria-label="Navegación principal">
<a class="nav-link @(ruta=="/Dashboard"?"active":"")" href="/Dashboard"><span aria-hidden="true">▦</span> Inicio</a>
@if(ingreso){
<details class="nav-group" open="@(ruta.StartsWith("/Clientes")||ruta.StartsWith("/Proveedores")||ruta.StartsWith("/Productos")||ruta.StartsWith("/Variantes")?"open":null)"><summary>CATÁLOGOS</summary><a class="nav-link @(ruta.StartsWith("/Clientes")?"active":"")" href="/Clientes">Clientes</a><a class="nav-link @(ruta.StartsWith("/Proveedores")?"active":"")" href="/Proveedores">Proveedores</a><a class="nav-link @(ruta.StartsWith("/Productos")?"active":"")" href="/Productos">Productos</a><a class="nav-link @(ruta.StartsWith("/Variantes")?"active":"")" href="/Variantes">Variantes</a></details>}
<details class="nav-group" open="@(ruta.StartsWith("/Cotizaciones")||ruta.StartsWith("/Facturas")||ruta.StartsWith("/Cobros")||ruta.StartsWith("/Devoluciones")?"open":null)"><summary>VENTAS</summary>@if(ingreso){<a class="nav-link @(ruta.StartsWith("/Cotizaciones")?"active":"")" href="/Cotizaciones">Cotizaciones</a>}<a class="nav-link @(ruta.StartsWith("/Facturas")?"active":"")" href="/Facturas">Facturas</a>@if(rol is "Gerente" or "Cajero"){<a class="nav-link @(ruta.StartsWith("/Cobros")?"active":"")" href="/Cobros">Cobros</a>}@if(rol=="Gerente"){<a class="nav-link @(ruta.StartsWith("/Devoluciones")?"active":"")" href="/Devoluciones">Devoluciones</a>}</details>
@if(rol=="Gerente"){<details class="nav-group" open="@(ruta.StartsWith("/Reportes")?"open":null)"><summary>REPORTES</summary><a class="nav-link @((ruta=="/Reportes/Ventas"||(ruta=="/Reportes/Productos"&&Context.Request.Query["vista"]=="ventas"))?"active":"")" href="/Reportes/Ventas">Ventas por fechas</a><a class="nav-link @(Context.Request.Query["vista"]=="mas-vendidos"?"active":"")" href="/Reportes/Productos?vista=mas-vendidos">Productos más vendidos</a><a class="nav-link @(Context.Request.Query["vista"]=="mayores-ingresos"?"active":"")" href="/Reportes/Productos?vista=mayores-ingresos">Mayores ingresos</a><a class="nav-link @(Context.Request.Query["vista"]=="menos-vendidos"?"active":"")" href="/Reportes/Productos?vista=menos-vendidos">Menos vendidos</a><a class="nav-link @(ruta=="/Reportes/Inventario"?"active":"")" href="/Reportes/Inventario">Productos sin stock</a><a class="nav-link @(ruta=="/Reportes/Factura"?"active":"")" href="/Reportes/Factura">Consulta de factura</a></details>}
@if(ingreso){<details class="nav-group" open="@(ruta.StartsWith("/Bodegas")||ruta.StartsWith("/Ubicaciones")||ruta.StartsWith("/Inventario")||ruta.StartsWith("/ProveedorProducto")||ruta.StartsWith("/Compras")||ruta.StartsWith("/Recepciones")?"open":null)"><summary>COMPRAS E INVENTARIO</summary><a class="nav-link @(ruta.StartsWith("/ProveedorProducto")?"active":"")" href="/ProveedorProducto">Proveedor / variante</a><a class="nav-link @(ruta.StartsWith("/Compras")?"active":"")" href="/Compras">Órdenes de compra</a><a class="nav-link @(ruta.StartsWith("/Recepciones")?"active":"")" href="/Recepciones">Recepciones</a><a class="nav-link @(ruta.StartsWith("/Inventario")?"active":"")" href="/Inventario">Inventario</a><a class="nav-link @(ruta.StartsWith("/Bodegas")?"active":"")" href="/Bodegas">Bodegas</a><a class="nav-link @(ruta.StartsWith("/Ubicaciones")?"active":"")" href="/Ubicaciones">Ubicaciones</a></details>
<details class="nav-group" open="@(ruta.StartsWith("/Empleados")||ruta.StartsWith("/Usuarios")||ruta.StartsWith("/Roles")?"open":null)"><summary>ADMINISTRACIÓN</summary><a class="nav-link @(ruta.StartsWith("/Empleados")?"active":"")" href="/Empleados">Empleados</a>@if(rol=="Gerente"){<a class="nav-link @(ruta.StartsWith("/Usuarios")?"active":"")" href="/Usuarios">Usuarios</a><a class="nav-link @(ruta.StartsWith("/Roles")?"active":"")" href="/Roles">Roles</a>}</details>}
</nav><div class="sidebar-foot"><span class="dot"></span> CloudColor · Sistema de gestión</div></aside><button class="sidebar-backdrop" type="button" aria-label="Cerrar navegación" hidden></button>
<div class="app-shell"><header class="topbar"><button class="menu-toggle" type="button" aria-label="Abrir navegación" aria-controls="navegacion" aria-expanded="false">☰</button><span class="page-context">@ViewData["Title"]</span><div class="global-search" role="search"><span class="search-icon" aria-hidden="true">⌕</span><label class="sr-only" for="global-query">Buscar en CloudColor</label><input id="global-query" type="search" maxlength="80" autocomplete="off" placeholder="Buscar en CloudColor…" aria-expanded="false" aria-controls="global-results"/><button type="button" class="search-clear text-button" aria-label="Limpiar búsqueda global" hidden>×</button><div id="global-results" class="search-results" aria-label="Resultados de búsqueda" hidden></div><span id="search-status" class="sr-only" role="status"></span></div><details class="session-menu"><summary><span class="avatar">@(User.Identity?.Name?.FirstOrDefault().ToString().ToUpper()??"C")</span><span><strong>@User.Identity?.Name</strong><small>@rol</small></span></summary><div class="session-panel"><strong>@User.Identity?.Name</strong><p>@rol</p><span>Mi sesión</span><p class="muted">Los permisos se verifican en cada operación.</p><form method="post" action="/Salir">@Html.AntiForgeryToken()<button class="text-button" type="submit">Cerrar sesión</button></form></div></details></header><main id="contenido" class="content">
@RenderBody()</main><footer class="app-footer">CloudColor <span>Gestión simple. Información conectada.</span></footer></div>
<partial name="_Overlays"/><script src="/js/site.js" asp-append-version="true" defer></script><script src="/js/ux.js" asp-append-version="true" defer></script><script src="/js/cart.js" asp-append-version="true" defer></script>@await RenderSectionAsync("Scripts",required:false)</body></html>
