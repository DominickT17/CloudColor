@model DashboardVm
@{ViewData["Title"]="Inicio";}
<div class="page-heading"><div><span class="eyebrow">PANORAMA GENERAL</span><h1>Todo en perspectiva.</h1><p>Bienvenido, @User.Identity?.Name. Así está tu operación hoy.</p></div><span class="date-label">@DateTime.Today.ToString("dd MMMM yyyy")</span></div>
<section class="welcome-banner"><div><span class="eyebrow">CLOUDCOLOR</span><h2>Menos pasos.<br/>Más claridad.</h2><p>Del primer ingreso a la última venta,<br/>cada movimiento conectado.</p><a class="button dark" href="@(User.IsInRole("Cajero")?"/Cobros":"/Inventario")">@(User.IsInRole("Cajero")?"Ir a cobros":"Explorar inventario") →</a></div><div class="color-composition" aria-hidden="true"><span></span><span></span><span></span><span></span><span></span></div></section>
<div class="section-heading"><h2>Tu operación, en números</h2><span class="muted">Datos actuales de CloudColor</span></div><section class="metrics">@foreach(var m in Model.Metricas){<a class="metric card" href="@m.Ruta"><span>@m.Nombre</span><strong>@m.Valor</strong><small>@m.Nota <span aria-hidden="true">↗</span></small></a>}</section>
<section class="card activity"><div class="section-heading"><div><h2>Actividad reciente</h2><p class="muted">Los últimos documentos de tu operación.</p></div><span class="badge blue">EN TU SISTEMA</span></div>
@if(Model.Actividad.Count==0){<div class="empty"><span class="empty-symbol">↗</span><h3>Aquí empieza el siguiente movimiento</h3><p>Tus cotizaciones, compras y facturas aparecerán aquí cuando se registren.</p></div>}else{<div class="table-wrap"><table><thead><tr><th>Documento</th><th>Cliente / proveedor</th><th>Fecha</th><th>Estado</th><th>Detalle</th></tr></thead><tbody>@foreach(var x in Model.Actividad){<tr><td><small>@x.Tipo</small><strong>@x.Numero</strong></td><td>@x.Persona</td><td>@x.Fecha.ToString("dd MMM · HH:mm")</td><td><partial name="_Estado" model="x.Estado"/></td><td><a href="@x.Ruta" class="text-button">Ver →</a></td></tr>}</tbody></table></div>}</section>
