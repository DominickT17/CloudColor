@model DashboardVm
@{ViewData["Title"]="Inicio";var ingreso=User.IsInRole("Gerente")||User.IsInRole("Digitador");}
<div class="page-heading"><div><span class="eyebrow">PANORAMA GENERAL</span><h1>Todo en perspectiva.</h1><p>Bienvenido, @User.Identity?.Name. Así está tu operación hoy.</p></div><span class="date-label">@DateTime.Today.ToString("d 'de' MMMM 'de' yyyy")</span></div>
<section class="welcome-banner"><div><span class="eyebrow">CLOUDCOLOR</span><h2>Menos pasos.<br/>Más claridad.</h2><p>Del primer ingreso a la última venta,<br/>cada movimiento conectado.</p><a class="button dark" href="@(User.IsInRole("Cajero")?"/Cobros":"/Inventario")">@(User.IsInRole("Cajero")?"Ir a cobros":"Explorar inventario") <span class="hero-arrow" aria-hidden="true">→</span></a></div><div class="color-composition" aria-hidden="true"><span></span><span></span><span></span><span></span><span></span></div></section>
<section class="quick-actions" aria-labelledby="acciones-title"><div class="section-heading"><div><h2 id="acciones-title">¿Qué necesitas hacer?</h2><p class="muted">Accesos directos a las tareas más frecuentes.</p></div></div><div class="quick-action-grid">
@if(ingreso){
<a class="quick-action card primary-action" href="/Facturas/Nueva"><span class="quick-action-index" aria-hidden="true">01</span><span><strong>Emitir factura</strong><small>Registrar una venta directa</small></span><span class="quick-action-arrow" aria-hidden="true">→</span></a>
<a class="quick-action card" href="/Cotizaciones/Nueva"><span class="quick-action-index" aria-hidden="true">02</span><span><strong>Crear cotización</strong><small>Preparar una propuesta para un cliente</small></span><span class="quick-action-arrow" aria-hidden="true">→</span></a>
<a class="quick-action card" href="/Compras/Nueva"><span class="quick-action-index" aria-hidden="true">03</span><span><strong>Crear orden de compra</strong><small>Solicitar productos a un proveedor</small></span><span class="quick-action-arrow" aria-hidden="true">→</span></a>
<a class="quick-action card" href="/Recepciones"><span class="quick-action-index" aria-hidden="true">04</span><span><strong>Registrar recepción</strong><small>Ingresar una entrega de proveedor</small></span><span class="quick-action-arrow" aria-hidden="true">→</span></a>
}
@if(!ingreso){
<a class="quick-action card" href="/Facturas"><span class="quick-action-index" aria-hidden="true">01</span><span><strong>Consultar facturas</strong><small>Buscar ventas y revisar sus estados</small></span><span class="quick-action-arrow" aria-hidden="true">→</span></a>
<a class="quick-action card primary-action" href="/Cobros"><span class="quick-action-index" aria-hidden="true">02</span><span><strong>Cobrar una factura</strong><small>Ver facturas pendientes de pago</small></span><span class="quick-action-arrow" aria-hidden="true">→</span></a>
}
</div></section>
<section class="card activity"><div class="section-heading"><div><h2>Actividad reciente</h2><p class="muted">Abre una cotización, compra o factura para continuar donde quedó.</p></div><span class="badge blue">ÚLTIMOS MOVIMIENTOS</span></div>
@if(Model.Actividad.Count==0){<div class="empty"><span class="empty-symbol">↗</span><h3>Aquí empieza el siguiente movimiento</h3><p>Tus cotizaciones, compras y facturas aparecerán aquí cuando se registren.</p></div>}else{<div class="table-wrap"><table><thead><tr><th>Documento</th><th>Cliente / proveedor</th><th>Fecha</th><th>Estado</th><th>Detalle</th></tr></thead><tbody>@foreach(var x in Model.Actividad){<tr><td><small>@x.Tipo</small><strong>@x.Numero</strong></td><td>@x.Persona</td><td>@x.Fecha.ToString("dd MMM · HH:mm")</td><td><partial name="_Estado" model="x.Estado"/></td><td><a href="@x.Ruta" class="text-button">Abrir →</a></td></tr>}</tbody></table></div>}</section>
<div class="section-heading"><h2>Tu operación, en números</h2><span class="muted">Datos actuales de CloudColor</span></div><section class="metrics">@foreach(var m in Model.Metricas){<a class="metric card" href="@m.Ruta"><span>@m.Nombre</span><strong class="metric-number">@m.Valor</strong><small>@m.Nota <span aria-hidden="true">↗</span></small></a>}</section>
<details class="dashboard-insights"><summary>Ver gráficos de estado</summary><section class="chart-grid" aria-label="Distribución de documentos">
@foreach(var chart in Model.Graficos){var total=chart.Barras.Sum(b=>b.Cantidad);<article class="card chart-card"><h2>@chart.Titulo</h2><p>@chart.Nota</p>
@if(total==0){<div class="empty compact"><p>Todavía no hay documentos para este gráfico.</p></div>}else{@foreach(var bar in chart.Barras){<div class="chart-row"><a href="@bar.Ruta">@bar.Nombre.Replace('_',' ')</a><progress max="@total" value="@bar.Cantidad" aria-label="@bar.Nombre: @bar.Cantidad de @total"></progress><strong>@bar.Cantidad</strong></div>}}
</article>}
</section></details>
