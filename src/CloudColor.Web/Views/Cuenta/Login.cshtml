@{ Layout=null; }
<!DOCTYPE html><html lang="es"><head><meta charset="utf-8"/><link rel="icon" href="/favicon.svg" type="image/svg+xml"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>Iniciar sesión · CloudColor</title><link rel="stylesheet" href="/css/site.css"/></head>
<body class="login-page"><main class="login-shell"><section class="login-story"><a class="brand" href="/Login"><span class="brand-mark">C</span> CloudColor</a><div><span class="eyebrow">CADA DETALLE, EN SU LUGAR</span><h1>Todo el color.<br/>Toda tu operación.</h1><p>Inventario, compras y ventas conectados en un mismo espacio.</p><div class="swatches" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i></div></div><small>Un espacio claro para trabajar mejor.</small></section><section class="login-form"><span class="eyebrow">BIENVENIDO DE NUEVO</span><h2>Inicia sesión</h2><p class="muted">Accede al sistema de gestión CloudColor.</p>
@if(ViewBag.Error is string error){<div class="alert error" role="alert">@error</div>}
<form method="post" asp-action="Login"><label for="usuario">Usuario</label><input id="usuario" name="usuario" autocomplete="username" maxlength="50" required autofocus/><label for="password">Contraseña</label><input id="password" name="password" type="password" autocomplete="current-password" maxlength="128" required/><button class="button primary full" type="submit">Iniciar sesión <span aria-hidden="true">→</span></button></form><p class="login-note">Usa tu cuenta y tus permisos habituales.</p></section></main><script src="/js/site.js" defer></script></body></html>