@model ListadoCatalogo
@{var c=Model.Catalogo;ViewData["Title"]=c.Titulo;var columnas=c.Campos.Where(f=>f.Tipo!="textarea"&&f.Nombre is not ("Direccion" or "Correo" or "Activo")).ToList();}
<div class="page-heading"><div><span class="eyebrow">TU ESPACIO DE TRABAJO</span><h1>@c.Titulo</h1><p>@c.Descripcion</p></div>@if(c.Crear){<a class="button primary" href="/@c.Ruta/Editar?buscar=@Uri.EscapeDataString(Model.Buscar??"")">+ Crear @c.Singular</a>}</div>
<section class="card"><div class="card-toolbar"><form method="get" class="search" role="search"><label class="sr-only" for="buscar">Buscar @c.Singular</label><input id="buscar" name="buscar" type="search" value="@Model.Buscar" maxlength="180" placeholder="Buscar @c.Singular…"/><button class="button" type="submit">Buscar</button>@if(!string.IsNullOrWhiteSpace(Model.Buscar)){<a class="text-button" href="/@c.Ruta">Limpiar búsqueda</a>}</form><span class="muted">@Model.Filas.Count @(Model.Filas.Count==1?"registro":"registros")</span></div>
@if(Model.Filas.Count==0){<div class="empty"><span class="empty-symbol">◇</span><h2>Un espacio para tu próximo @c.Singular</h2><p>No hay resultados para esta búsqueda. @(c.Crear?"Crea un registro o cambia el filtro.":"Cambia o limpia el filtro para consultar los perfiles existentes.")</p></div>}else{<div class="table-wrap"><table><thead><tr>@foreach(var f in columnas){<th scope="col">@f.Etiqueta</th>}<th scope="col">Estado</th><th scope="col">Acciones</th></tr></thead><tbody>@foreach(var o in Model.Filas){<tr>@foreach(var f in columnas){<td>@c.Mostrar(o,f)</td>}<td><partial name="_Estado" model="@(c.Activo(o)?"ACTIVO":"INACTIVO")"/></td><td><div class="row-actions"><a class="text-button" href="/@c.Ruta/Editar/@c.ID(o)?buscar=@Uri.EscapeDataString(Model.Buscar??"")">Editar</a>@if(c.Activar!=null){<form method="post" action="/@c.Ruta/Estado/@c.ID(o)" data-confirm="¿Deseas @(c.Activo(o)?"desactivar":"activar") @c.Singular: @c.Mostrar(o,columnas[0])?">@Html.AntiForgeryToken()<input type="hidden" name="activo" value="@((!c.Activo(o)).ToString().ToLower())"/><input type="hidden" name="buscar" value="@Model.Buscar"/><button class="text-button" type="submit">@(c.Activo(o)?"Desactivar":"Activar")</button></form>}</div></td></tr>}</tbody></table></div>}
</section>
@if(c.Ruta is "Productos" or "Variantes"){<details class="card auxiliary"><summary>Catálogo auxiliar · @(c.Ruta=="Productos"?"Nueva marca":"Nuevo color")</summary><form method="post" action="/@c.Ruta/@(c.Ruta=="Productos"?"Marca":"Color")" class="inline-form">@Html.AntiForgeryToken()<label for="auxNombre">Nombre</label><input id="auxNombre" name="nombre" maxlength="80" required/>@if(c.Ruta=="Variantes"){<label for="auxHex">Código hexadecimal (opcional)</label><input id="auxHex" name="codigoHex" placeholder="#RRGGBB" maxlength="7"/>}<button class="button" type="submit">Crear</button></form></details>}
