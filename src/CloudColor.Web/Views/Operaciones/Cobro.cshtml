@model CobroVm
@{ViewData["Title"]="Registrar cobro";var f=Model.Factura;var d=Model.Input;decimal pagado=Model.Existentes.Sum(x=>x.Monto),distribuido=d.Pagos.Sum(x=>x.Monto);}
<a class="breadcrumb" href="/Facturas/Ver/@f.FacturaID">← Volver a factura</a><div class="page-heading"><div><span class="eyebrow">UN COBRO CLARO, DE PRINCIPIO A FIN</span><h1>Completar pago</h1><p>@f.NumeroFactura · @f.Cliente</p></div><partial name="_Estado" model="f.Estado"/></div>
<form method="post" action="/Cobros/Registrar/@f.FacturaID">@Html.AntiForgeryToken()@if(!ViewData.ModelState.IsValid){<div asp-validation-summary="All" class="validation" role="alert"></div>}<div class="document-grid"><section class="card document-section"><h2>Distribución del pago</h2><p class="muted spaced">Combina medios hasta completar exactamente el total.</p><div class="form-grid spaced"><div class="field"><label for="NuevoMedio">Medio de pago</label><select name="NuevoMedio" id="NuevoMedio"><option value="0">Selecciona un medio</option>@foreach(var m in Model.Medios){<option value="@m.ID" selected="@(m.ID==d.NuevoMedio)">@m.Nombre</option>}</select></div><div class="field"><label for="NuevoMonto">Monto (Q)</label><input id="NuevoMonto" name="NuevoMonto" type="number" min="0.01" step="0.01" value="@d.NuevoMonto.ToString(CultureInfo.InvariantCulture)"/></div><div class="field wide"><label for="NuevaReferencia">Referencia de cheque / tarjeta</label><input id="NuevaReferencia" name="NuevaReferencia" maxlength="100" value="@d.NuevaReferencia"/></div></div><button class="button spaced" type="submit" name="accion" value="Agregar" formnovalidate disabled="@(f.Estado!="PENDIENTE_PAGO")">+ Agregar medio de pago</button>
@if(d.Pagos.Count==0){<div class="empty compact"><span class="empty-symbol">◇</span><p>Aún no has distribuido el pago.</p></div>}else{<div class="table-wrap spaced"><table><thead><tr><th>Medio</th><th>Referencia</th><th>Monto</th><th>Acción</th></tr></thead><tbody>@for(int i=0;i<d.Pagos.Count;i++){var p=d.Pagos[i];<tr><td>@Model.Medios.FirstOrDefault(x=>x.ID==p.MedioPagoID)?.Nombre<input type="hidden" name="Pagos[@i].MedioPagoID" value="@p.MedioPagoID"/></td><td>@p.Referencia<input type="hidden" name="Pagos[@i].Referencia" value="@p.Referencia"/></td><td>Q @p.Monto.ToString("N2")<input type="hidden" name="Pagos[@i].Monto" value="@p.Monto.ToString(CultureInfo.InvariantCulture)"/></td><td><button class="text-button" type="submit" name="accion" value="Quitar:@i" formnovalidate>Quitar</button></td></tr>}</tbody></table></div>}</section><aside class="card order-summary payment-summary"><span class="eyebrow">@f.NumeroFactura</span><h2>@f.Cliente</h2><div class="grand-total"><span>Total de factura</span><strong>Q @f.TotalActual.ToString("N2")</strong></div><div class="summary-line"><span>Pagado</span><strong>Q @pagado.ToString("N2")</strong></div><div class="summary-line"><span>Pendiente</span><strong>Q @((f.TotalActual-pagado).ToString("N2"))</strong></div><div class="summary-line"><span>Distribuido ahora</span><strong>Q @distribuido.ToString("N2")</strong></div><div class="summary-line"><span>Por distribuir</span><strong>Q @((f.TotalActual-pagado-distribuido).ToString("N2"))</strong></div><p>El cobro se registra completo y no podrá duplicarse.</p><button class="button primary full" type="submit" name="accion" value="Cobrar" formnovalidate disabled="@(f.Estado!="PENDIENTE_PAGO"||distribuido!=f.TotalActual)">Confirmar cobro</button><a class="button full" href="/Facturas/Ver/@f.FacturaID">Cancelar</a></aside></div></form>
