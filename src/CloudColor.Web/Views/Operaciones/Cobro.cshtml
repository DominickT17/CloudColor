@model CobroVm
@{ViewData["Title"]="Registrar cobro";var f=Model.Factura;var d=Model.Input;decimal pagado=Model.Existentes.Sum(x=>x.Monto),distribuido=d.Pagos.Sum(x=>x.Monto);}
<nav class="breadcrumb" aria-label="Ruta"><a href="/Facturas">Facturas</a> / <a href="/Facturas/Ver/@f.FacturaID">@f.NumeroFactura</a> / Cobro</nav>
<div class="page-heading"><div><span class="eyebrow">UN COBRO CLARO, DE PRINCIPIO A FIN</span><h1>Completar pago</h1><p>@f.NumeroFactura · @f.Cliente</p></div><partial name="_Estado" model="f.Estado"/></div>
<form method="post" data-payment="@f.Estado" data-pending="@((f.TotalActual-pagado).ToString(CultureInfo.InvariantCulture))" action="/Cobros/Registrar/@f.FacturaID">
@Html.AntiForgeryToken()@if(!ViewData.ModelState.IsValid){<div asp-validation-summary="All" class="validation" role="alert"></div>}
<div class="document-grid"><div class="document-main">
<details class="card document-section invoice-items"><summary>Detalle de factura · @Model.Detalle.Count variantes</summary><div class="table-wrap spaced"><table><thead><tr><th>Producto / SKU</th><th>Cantidad</th><th>Subtotal</th></tr></thead><tbody>@foreach(var line in Model.Detalle){<tr><td>@line.Producto<small>@line.CodigoSKU</small></td><td>@line.Cantidad.ToString("0.####")</td><td>Q @line.Subtotal.ToString("N2")</td></tr>}</tbody></table></div></details>
<section class="card document-section"><h2>Distribución del pago</h2><p class="muted spaced">Combina medios hasta completar exactamente el total.</p>
<div class="form-grid spaced"><div class="field"><label for="NuevoMedio">Medio de pago</label><select name="NuevoMedio" id="NuevoMedio"><option value="0">Selecciona un medio</option>@foreach(var m in Model.Medios){<option value="@m.ID" selected="@(m.ID==d.NuevoMedio)">@m.Nombre</option>}</select></div>
<div class="field"><label for="NuevoMonto">Monto (Q)</label><input id="NuevoMonto" name="NuevoMonto" type="number" min="0.01" step="0.01" value="@d.NuevoMonto.ToString(CultureInfo.InvariantCulture)"/></div>
<div class="field wide"><label for="NuevaReferencia">Referencia de cheque / tarjeta</label><input id="NuevaReferencia" name="NuevaReferencia" maxlength="100" value="@d.NuevaReferencia"/></div></div>
<p class="helper-note" data-payment-preview aria-live="polite">Agrega los medios necesarios para cubrir el total.</p>
<button class="button" type="submit" name="accion" value="Agregar" formnovalidate disabled="@(f.Estado!="PENDIENTE_PAGO")">+ Agregar medio de pago</button>
<div class="empty compact payment-empty" hidden="@(d.Pagos.Count>0)"><span class="empty-symbol">◇</span><p>Aún no has distribuido el pago.</p></div>
<div class="table-wrap spaced payment-lines"><table><thead><tr><th>Medio</th><th>Referencia</th><th>Monto</th><th>Acción</th></tr></thead><tbody>
@for(int i=0;i<d.Pagos.Count;i++){var p=d.Pagos[i];var nombre=Model.Medios.FirstOrDefault(x=>x.ID==p.MedioPagoID)?.Nombre;<tr><td data-label="Medio">@nombre<input type="hidden" name="Pagos[@i].MedioPagoID" value="@p.MedioPagoID"/></td><td data-label="Referencia"><input name="Pagos[@i].Referencia" value="@p.Referencia" aria-label="Referencia @nombre" maxlength="100" required="@(nombre is "Cheque" or "Tarjeta")"/></td><td data-label="Monto"><input class="payment-amount" name="Pagos[@i].Monto" value="@p.Monto.ToString(CultureInfo.InvariantCulture)" type="number" min="0.01" step="0.01" required aria-label="Monto @nombre"/></td><td data-label="Acción"><button class="text-button" type="submit" name="accion" value="Quitar:@i" formnovalidate>Quitar</button></td></tr>}
</tbody></table></div></section></div>
<aside class="card order-summary payment-summary"><span class="eyebrow">@f.NumeroFactura</span><h2>@f.Cliente</h2><div class="grand-total"><span>Total de factura</span><strong>Q @f.TotalActual.ToString("N2")</strong></div><div class="summary-line"><span>Pagado</span><strong>Q @pagado.ToString("N2")</strong></div><div class="summary-line"><span>Pendiente</span><strong>Q @((f.TotalActual-pagado).ToString("N2"))</strong></div><div class="summary-line"><span>Distribuido ahora</span><strong data-distributed>Q @distribuido.ToString("N2")</strong></div><div class="summary-line"><span>Por distribuir</span><strong data-remaining>Q @((f.TotalActual-pagado-distribuido).ToString("N2"))</strong></div><div class="alert info" data-payment-state role="status">Distribuye el importe pendiente.</div><p>El cobro se registra completo y no podrá duplicarse.</p><button class="button primary full" type="submit" name="accion" value="Cobrar" formnovalidate data-confirm="Se registrará el cobro completo de esta factura. ¿Continuar?" data-confirm-title="Registrar cobro" disabled="@(f.Estado!="PENDIENTE_PAGO"||distribuido!=f.TotalActual)">Confirmar cobro</button><a class="button full" href="/Facturas/Ver/@f.FacturaID">Cancelar</a></aside></div></form>
