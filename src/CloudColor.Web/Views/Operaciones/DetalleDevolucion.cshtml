@model DevolucionDetalleVm
@{ ViewData["Title"] = Model.Devolucion.NumeroDevolucion; var d = Model.Devolucion; }
<a class="breadcrumb" href="/Devoluciones">← Devoluciones</a>
<div class="page-heading"><div><span class="eyebrow">DEVOLUCIÓN REGISTRADA</span><h1>@d.NumeroDevolucion</h1><p>Factura <a href="/Facturas/Ver/@d.FacturaID">@d.NumeroFactura</a> · @d.FechaHora.ToString("dd MMM yyyy · HH:mm")</p></div><span class="badge green">@d.CantidadDevuelta.ToString("0.####") unidades</span></div>
<section class="card report-table-card"><div class="section-heading padded"><div><h2>Detalle y origen</h2><p class="muted">@d.Motivo · registrada por @d.Usuario</p></div></div><div class="table-wrap"><table><thead><tr><th>Producto</th><th>Lote de origen</th><th>Ubicación</th><th>Precio histórico</th><th>Cantidad devuelta</th></tr></thead><tbody>@foreach (var l in Model.Lineas) { <tr><td><strong>@l.Producto</strong><small>@l.CodigoSKU · @l.Presentacion · @(l.Color ?? "Sin color")</small></td><td>@(l.NumeroLoteProveedor ?? "Sin lote proveedor")<small>Ingreso @l.FechaIngreso.ToString("dd MMM yyyy")</small></td><td>@l.Bodega · @l.Ubicacion</td><td>Q @l.PrecioUnitario.ToString("N2")</td><td>@l.CantidadDevuelta.ToString("0.####")</td></tr> }</tbody></table></div></section>
