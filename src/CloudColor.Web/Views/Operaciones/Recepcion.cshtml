@model RecepcionVm
@{ViewData["Title"]="Registrar recepción";var d=Model.Input;}
<nav class="breadcrumb" aria-label="Ruta"><a href="/Compras">Compras</a> / <a href="/Compras/Ver/@Model.Orden.OrdenCompraID">@Model.Orden.NumeroOrden</a> / Recepción</nav><div class="page-heading"><div><span class="eyebrow">INGRESO A BODEGA</span><h1>Recibir mercadería</h1><p>@Model.Orden.Proveedor · Orden @Model.Orden.NumeroOrden</p></div><partial name="_Estado" model="Model.Orden.Estado"/></div>
<form method="post" action="/Recepciones/Nueva/@Model.Orden.OrdenCompraID">@Html.AntiForgeryToken()@if(!ViewData.ModelState.IsValid){<div asp-validation-summary="All" class="validation" role="alert"></div>}<section class="card document-section"><h2>Información del ingreso</h2><div class="form-grid spaced"><div class="field"><label for="Numero">Número de recepción *</label><input id="Numero" name="Numero" maxlength="30" value="@d.Numero" required/></div><div class="field"><label for="FechaIngreso">Fecha de ingreso *</label><input id="FechaIngreso" name="FechaIngreso" type="date" value="@d.FechaIngreso.ToString("yyyy-MM-dd")" required/></div><div class="field wide"><label for="Observaciones">Observaciones</label><input id="Observaciones" name="Observaciones" maxlength="300" value="@d.Observaciones"/></div></div></section><p class="helper-note">Marca las líneas que recibirás. Una entrega menor al pendiente deja la orden parcial; al completar todas las líneas quedará completa.</p>
@for(int i=0;i<d.Lineas.Count;i++){var l=d.Lineas[i];var original=Model.Detalle.FirstOrDefault(x=>x.DetalleOrdenCompraID==l.DetalleOrdenCompraID);if(original==null){continue;}<section class="card document-section receipt-line"><div class="section-heading"><div><h2>@original.Producto</h2><p class="muted">@original.CodigoSKU · @original.Presentacion · @(original.Color??"Sin color")</p></div><label class="switch-label"><input type="checkbox" name="Lineas[@i].Incluir" value="true" checked="@l.Incluir"/> Recibir esta línea</label></div><input type="hidden" name="Lineas[@i].DetalleOrdenCompraID" value="@l.DetalleOrdenCompraID"/><div class="quantity-strip"><span>Solicitado <strong>@original.CantidadSolicitada.ToString("0.####")</strong></span><span>Recibido <strong>@original.CantidadRecibida.ToString("0.####")</strong></span><span>Pendiente <strong>@original.CantidadPendiente.ToString("0.####")</strong></span></div><div class="form-grid"><div class="field"><label for="cantidad-@i">Cantidad a recibir</label><input id="cantidad-@i" name="Lineas[@i].CantidadRecibida" type="number" min="0.0001" max="@original.CantidadPendiente.ToString(CultureInfo.InvariantCulture)" step="0.0001" value="@l.CantidadRecibida.ToString(CultureInfo.InvariantCulture)"/></div><div class="field"><label for="costo-@i">Costo real unitario (Q)</label><input id="costo-@i" name="Lineas[@i].CostoUnitario" type="number" min="0" step="0.01" value="@l.CostoUnitario.ToString(CultureInfo.InvariantCulture)"/></div><div class="field"><label for="ubicacion-@i">Bodega / ubicación</label><select id="ubicacion-@i" name="Lineas[@i].UbicacionID"><option value="0">Selecciona dónde almacenar</option>@foreach(var grupo in Model.Ubicaciones.GroupBy(x=>x.Bodega)){<optgroup label="@grupo.Key">@foreach(var u in grupo){<option value="@u.UbicacionID" selected="@(u.UbicacionID==l.UbicacionID)">@u.Etiqueta</option>}</optgroup>}</select></div><div class="field"><label for="lote-@i">Número de lote proveedor</label><input id="lote-@i" name="Lineas[@i].NumeroLoteProveedor" maxlength="60" value="@l.NumeroLoteProveedor"/><small>Obligatorio si el producto maneja lote.</small></div><div class="field"><label for="vence-@i">Vencimiento (opcional)</label><input id="vence-@i" name="Lineas[@i].FechaVencimiento" type="date" value="@l.FechaVencimiento?.ToString("yyyy-MM-dd")"/></div></div></section>}
@if(d.Lineas.Count==0){<div class="card empty"><h2>Orden recibida por completo</h2><p>No quedan cantidades pendientes.</p></div>}<div class="form-actions"><a class="button" href="/Compras/Ver/@Model.Orden.OrdenCompraID">Cancelar</a><button class="button primary" type="submit" data-confirm="Se registrará la recepción y se actualizará el inventario. ¿Continuar?" data-confirm-title="Registrar recepción" disabled="@(d.Lineas.Count==0)">Registrar recepción</button></div></form>
