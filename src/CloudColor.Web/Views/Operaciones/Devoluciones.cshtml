@model DevolucionesVm
@{ ViewData["Title"] = "Devoluciones"; }
<div class="page-heading"><div><span class="eyebrow">POSTVENTA · GERENCIA</span><h1>Devoluciones registradas.</h1><p>Consulta el historial o registra una devolución vinculada a una factura.</p></div><a class="button primary" href="/Devoluciones/Nueva">+ Registrar devolución</a></div>
<section class="card"><div class="card-toolbar"><form method="get" class="search"><label for="buscar" class="sr-only">Buscar devolución o factura</label><input id="buscar" name="buscar" value="@Model.Buscar" maxlength="180" placeholder="Número de devolución o factura…"/><button class="button" type="submit">Buscar</button></form><span class="muted">@Model.Filas.Count registros</span></div>
@if (Model.Filas.Count == 0) { <div class="empty"><span class="empty-symbol">↩</span><h2>Aún no hay devoluciones</h2><p>Al registrar una devolución, quedará vinculada a su factura y a los lotes originales.</p></div> }
else { <div class="table-wrap"><table><thead><tr><th>Devolución</th><th>Factura</th><th>Fecha</th><th>Unidades</th><th>Registró</th><th>Motivo</th><th></th></tr></thead><tbody>@foreach (var x in Model.Filas) { <tr><td><strong>@x.NumeroDevolucion</strong></td><td><a href="/Facturas/Ver/@x.FacturaID">@x.NumeroFactura</a></td><td>@x.FechaHora.ToString("dd MMM yyyy · HH:mm")</td><td>@x.CantidadDevuelta.ToString("0.####")</td><td>@x.Usuario</td><td>@x.Motivo</td><td><a class="text-button" href="/Devoluciones/Ver/@x.DevolucionID">Ver detalle →</a></td></tr> }</tbody></table></div> }</section>
