@model DetalleDocumentoVm
@{ Layout = null; var d = Model.Documento; }
<!DOCTYPE html><html lang="es"><head><meta charset="utf-8"/><link rel="icon" href="/favicon.svg" type="image/svg+xml"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>Factura @d.Numero · CloudColor</title><link rel="stylesheet" href="/css/site.css"/></head><body class="print-page"><div class="print-tools"><button class="button primary" type="button" id="imprimir">Imprimir factura</button><a class="button" href="/Facturas/Ver/@d.Id">Volver</a></div>
<main class="invoice-paper"><header class="invoice-header"><div class="brand"><span class="brand-mark">C</span> CloudColor</div><div><h1>Factura</h1><strong>@d.Numero</strong></div></header>
<div class="invoice-parties"><div><span class="eyebrow">CLIENTE</span><h2>@d.Persona</h2><p>NIT: @(Model.NIT ?? "Sin NIT")</p></div><div><p>Fecha: @d.Fecha.ToString("dd/MM/yyyy HH:mm")</p><p>Empleado: @Model.Emisor</p><p>Usuario emisor: @Model.UsuarioEmisor</p><p>Estado: @d.Estado.Replace('_', ' ')</p></div></div>
@if (d.Estado == "ANULADA") { <h2 class="badge red">ANULADA</h2> }
<table><thead><tr><th>Producto / presentación / color</th><th>Cantidad</th><th>Precio</th><th>Subtotal</th></tr></thead><tbody>@foreach (var l in Model.Venta) { <tr><td><strong>@l.Producto</strong><small>@l.CodigoSKU · @l.Presentacion · @(l.Color ?? "Sin color")</small></td><td>@l.Cantidad.ToString("0.####")</td><td>Q @l.PrecioUnitario.ToString("N2")</td><td>Q @l.Subtotal.ToString("N2")</td></tr> }</tbody></table>
@if (d.Estado == "ANULADA" && Model.TotalOriginal.HasValue) { <div class="detail-total"><span>Total original conservado</span><strong>Q @Model.TotalOriginal.Value.ToString("N2")</strong></div> }
<div class="detail-total"><span>Total actual</span><strong>Q @d.Total?.ToString("N2")</strong></div><h2>Medios de pago</h2>@if (Model.Pagos.Count == 0) { <p>Sin pagos registrados.</p> }@foreach (var p in Model.Pagos) { <p>@p.Medio · Q @p.Monto.ToString("N2") · Referencia: @(p.Referencia ?? "—") · Cajero: @p.Cajero</p> }<footer>CloudColor · Documento de la operación registrada.</footer></main><script src="/js/site.js" defer></script></body></html>
