@model EditorDocumentoVm
@{ViewData["Title"]=Model.Titulo;var d=Model.Input;bool compra=Model.Ruta=="Compras";bool origen=d.CotizacionId.HasValue&&Model.Ruta=="Facturas";var proveedorSeleccionado=Model.Personas.FirstOrDefault(x=>x.Valor==d.PersonaId.ToString());}
<nav class="breadcrumb" aria-label="Ruta"><a href="/@Model.Ruta">@Model.Ruta</a> / @Model.Titulo</nav>
<div class="page-heading"><div><span class="eyebrow">@(compra?"ABASTECIMIENTO":"VENTAS")</span><h1>@Model.Titulo</h1><p>@(origen?"El cliente y los precios provienen de la cotización confirmada.":compra?"Elige el proveedor, carga su catálogo y agrega las variantes que necesitas.":"Busca una variante y ajusta cantidades y precios antes de guardar.")</p></div><span class="badge @(origen?"green":"blue")">@(origen?"COTIZACIÓN CONFIRMADA":"BORRADOR")</span></div>
@if(compra){<div class="purchase-guide" role="note"><strong>Compra en 3 pasos</strong><span><b>1</b> Elige proveedor y pulsa <em>Cargar variantes</em>.</span><span><b>2</b> Busca por producto o SKU y agrega cada variante.</span><span><b>3</b> Guarda la orden y registra la recepción cuando llegue.</span></div>}
<form method="post" class="document-form" data-cart="@(!origen?"editable":"readonly")" data-sale="@(!compra?"true":"false")" data-purchase="@(compra?"true":"false")" data-loaded-provider="@d.PersonaId" action="/@Model.Ruta/Nueva">
@Html.AntiForgeryToken()@await Html.PartialAsync("_ValidationSummary")
@if(origen){<input name="CotizacionId" type="hidden" value="@d.CotizacionId"/>}
<div class="document-grid"><div class="document-main">
<section class="card document-section"><div class="section-heading"><h2>01 · Información general</h2><span class="muted">@DateTime.Today.ToString("dd MMM yyyy")</span></div>
<div class="form-grid"><div class="field"><label for="Numero">Número de documento *</label><input id="Numero" name="Numero" value="@d.Numero" maxlength="30" required/></div>
<div class="field"><label for="PersonaId">@(compra?"Proveedor":"Cliente") *</label><select id="PersonaId" name="PersonaId" aria-describedby="@(compra?"proveedor-guia":null)" disabled="@origen" required><option value="">@(compra?"Selecciona el proveedor":"Selecciona una opción")</option>@foreach(var x in Model.Personas){<option value="@x.Valor" selected="@(x.Valor==d.PersonaId.ToString())">@x.Texto</option>}</select>
@if(origen){<input name="PersonaId" type="hidden" value="@d.PersonaId"/>}
@if(compra){<button class="button purchase-load" type="submit" name="accion" value="Proveedor" formnovalidate data-confirm="@(d.Detalle.Count>0?"Cambiar proveedor vaciará las líneas actuales. ¿Continuar?":null)">Cargar variantes del proveedor →</button><small id="proveedor-guia" class="purchase-provider-help" aria-live="polite">@(d.PersonaId<=0?"Primero elige un proveedor.":Model.Variantes.Count==0?"Este proveedor no tiene variantes activas asociadas. Revisa Proveedor / variante.":$"{Model.Variantes.Count} variantes disponibles para {proveedorSeleccionado?.Texto}.")</small>}
</div>
@if(Model.Ruta=="Cotizaciones"){<div class="field"><label for="FechaVencimiento">Vencimiento (opcional)</label><input type="date" id="FechaVencimiento" name="FechaVencimiento" value="@d.FechaVencimiento?.ToString("yyyy-MM-dd")"/></div>}
@if(Model.Ruta!="Facturas"){<div class="field"><label for="Observaciones">Observaciones</label><input id="Observaciones" name="Observaciones" value="@d.Observaciones" maxlength="300"/></div>}
</div></section>
<section class="card document-section"><div class="section-heading"><h2>02 · Detalle de @(compra?"compra":"venta")</h2><span class="muted"><span data-cart-count>@d.Detalle.Count</span> variantes</span></div>
@if(!origen){
<div class="field variant-search"><label for="buscar-variante">Búsqueda rápida de producto o SKU</label><input id="buscar-variante" type="search" placeholder="@(compra&&Model.Variantes.Count==0?"Carga primero las variantes del proveedor":"Escribe producto, presentación, color o SKU…")" autocomplete="off" disabled="@(compra&&Model.Variantes.Count==0)"/><small class="muted" data-variant-count>@(compra&&Model.Variantes.Count>0?$"{Model.Variantes.Count} variantes disponibles. Busca y agrega más de una.":null)</small></div>
<div class="line-entry"><div class="field variant-field"><label for="NuevaVariante">Variante</label><select id="NuevaVariante" name="NuevaVariante" data-suggest-price="@(!compra?"true":"false")" disabled="@(compra&&Model.Variantes.Count==0)"><option value="0">@(compra&&Model.Variantes.Count==0?"Primero carga variantes del proveedor":"Selecciona una variante")</option>
@foreach(var v in Model.Variantes){<option value="@v.ProductoVarianteID" data-precio="@v.PrecioVentaActual.ToString(CultureInfo.InvariantCulture)" data-sku="@v.CodigoSKU" data-producto="@v.Producto" data-presentacion="@v.Presentacion" data-color="@(v.Color??"Sin color")" data-disponible="@Model.Disponible.GetValueOrDefault(v.ProductoVarianteID).ToString(CultureInfo.InvariantCulture)" selected="@(v.ProductoVarianteID==d.NuevaVariante)">@v.Etiqueta</option>}
</select>@if(!compra){<small class="availability" aria-live="polite">Selecciona una variante para consultar disponibilidad.</small>}</div>
<div class="field"><label for="NuevaCantidad">Cantidad</label><input id="NuevaCantidad" name="NuevaCantidad" type="number" min="0.0001" step="0.0001" value="@d.NuevaCantidad.ToString(CultureInfo.InvariantCulture)"/></div>
<div class="field"><label for="NuevoPrecio">@(compra?"Costo Q":"Precio Q")</label><input id="NuevoPrecio" name="NuevoPrecio" type="number" min="0" step="0.01" value="@d.NuevoPrecio.ToString(CultureInfo.InvariantCulture)"/></div>
<button class="button" type="submit" name="accion" value="Agregar" formnovalidate disabled="@(compra&&Model.Variantes.Count==0)">@(compra?"+ Agregar producto":"+ Agregar")</button></div>}
<div class="empty compact cart-empty" hidden="@(d.Detalle.Count>0)"><span class="empty-symbol">+</span>@if(compra&&d.PersonaId<=0){<h3>Primero elige un proveedor</h3><p>Cárgalo arriba para mostrar sus productos y variantes.</p>}else if(compra&&Model.Variantes.Count==0){<h3>Este proveedor aún no tiene productos vinculados</h3><p>Asocia sus variantes antes de generar la orden.</p><a class="button" href="/ProveedorProducto/Editar">Abrir Proveedor / variante</a>}else{<h3>Agrega los productos a la orden</h3><p>Busca una variante, indica cantidad y costo, y pulsa “Agregar producto”.</p>}</div>
<div class="table-wrap cart-lines"><table><thead><tr><th>Producto / variante</th><th>Cantidad</th><th>@(compra?"Costo":"Precio")</th><th>Subtotal</th>@if(!origen){<th>Acción</th>}</tr></thead><tbody>
@for(int i=0;i<d.Detalle.Count;i++){var l=d.Detalle[i];<tr><td data-label="Producto / variante"><strong>@l.Producto</strong><small>@l.CodigoSKU · @l.Presentacion · @(l.Color??"Sin color")</small><input type="hidden" name="Detalle[@i].ProductoVarianteID" value="@l.ProductoVarianteID"/></td>
<td data-label="Cantidad"><input aria-label="Cantidad @l.CodigoSKU" class="cart-quantity" name="Detalle[@i].Cantidad" value="@l.Cantidad.ToString(CultureInfo.InvariantCulture)" type="@(origen?"hidden":"number")" min="0.0001" step="0.0001" required/>@if(origen){@l.Cantidad.ToString("0.####")}</td>
<td data-label="Precio"><input aria-label="Precio @l.CodigoSKU" class="cart-price" name="Detalle[@i].PrecioUnitario" value="@l.PrecioUnitario.ToString(CultureInfo.InvariantCulture)" type="@(origen?"hidden":"number")" min="0" step="0.01" required/>@if(origen){<span>Q @l.PrecioUnitario.ToString("N2")</span>}</td>
<td data-label="Subtotal" class="cart-subtotal">Q @l.Subtotal.ToString("N2")</td>@if(!origen){<td data-label="Acción"><button class="text-button" type="submit" name="accion" value="Quitar:@i" formnovalidate aria-label="Quitar @l.CodigoSKU">Quitar</button></td>}</tr>}
</tbody></table></div></section></div>
<aside class="card order-summary"><span class="eyebrow">RESUMEN DEL DOCUMENTO</span><h2>Todo en orden.</h2><div class="summary-line"><span>Variantes</span><strong data-cart-count>@d.Detalle.Count</strong></div><div class="summary-line"><span>Subtotal</span><strong data-cart-total>Q @Fase2Servicio.Total(d.Detalle).ToString("N2")</strong></div><div class="grand-total"><span>Total</span><strong data-cart-total aria-live="polite">Q @Fase2Servicio.Total(d.Detalle).ToString("N2")</strong></div><p>@(Model.Ruta=="Facturas"?"Disponibilidad orientativa. El inventario y PEPS se verifican al emitir.":compra?"El inventario se actualiza al registrar la recepción.":"Guarda y confirma la cotización antes de facturar.")</p>@if(compra){<p class="purchase-compare-note">Cada orden es de un proveedor. Para comparar el mismo producto, debe estar asociado a ambos; crea una orden por proveedor y compara los costos registrados.</p>}<button class="button primary full" type="submit" name="accion" value="Guardar" data-confirm="@(Model.Ruta=="Facturas"?"La factura descontará existencias. ¿Deseas emitirla?":null)" data-confirm-title="Emitir factura" disabled="@(d.Detalle.Count==0)">@(Model.Ruta=="Facturas"?"Emitir factura":"Guardar documento")</button><a class="button full" href="/@Model.Ruta">Cancelar</a></aside></div></form>
