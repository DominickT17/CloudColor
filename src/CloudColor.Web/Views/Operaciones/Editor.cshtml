@model EditorDocumentoVm
@{ViewData["Title"]=Model.Titulo;var d=Model.Input;bool compra=Model.Ruta=="Compras";bool origen=d.CotizacionId.HasValue&&Model.Ruta=="Facturas";}
<a class="breadcrumb" href="/@Model.Ruta">← @Model.Ruta</a><div class="page-heading"><div><span class="eyebrow">@(compra?"ABASTECIMIENTO":"VENTAS")</span><h1>@Model.Titulo</h1><p>@(origen?"El cliente y los precios provienen de la cotización confirmada.":"Agrega variantes, revisa el detalle y registra el documento.")</p></div><span class="badge blue">BORRADOR</span></div>
<form method="post" class="document-form" action="/@Model.Ruta/Nueva">@Html.AntiForgeryToken()@if(!ViewData.ModelState.IsValid){<div asp-validation-summary="All" class="validation" role="alert"></div>}
@if(origen){<input name="CotizacionId" type="hidden" value="@d.CotizacionId"/>}
<div class="document-grid"><div class="document-main"><section class="card document-section"><div class="section-heading"><h2>01 · Información general</h2><span class="muted">@DateTime.Today.ToString("dd MMM yyyy")</span></div><div class="form-grid"><div class="field"><label for="Numero">Número de documento *</label><input id="Numero" name="Numero" value="@d.Numero" maxlength="30" required/></div><div class="field"><label for="PersonaId">@(compra?"Proveedor":"Cliente") *</label><select id="PersonaId" name="PersonaId" disabled="@origen" required><option value="">Selecciona una opción</option>@foreach(var x in Model.Personas){<option value="@x.Valor" selected="@(x.Valor==d.PersonaId.ToString())">@x.Texto</option>}</select>@if(origen){<input name="PersonaId" type="hidden" value="@d.PersonaId"/>}@if(compra){<button class="text-button" type="submit" name="accion" value="Proveedor" formnovalidate>Cargar variantes del proveedor →</button>}</div>@if(Model.Ruta=="Cotizaciones"){<div class="field"><label for="FechaVencimiento">Vencimiento (opcional)</label><input type="date" id="FechaVencimiento" name="FechaVencimiento" value="@d.FechaVencimiento?.ToString("yyyy-MM-dd")"/></div>}@if(Model.Ruta!="Facturas"){<div class="field"><label for="Observaciones">Observaciones</label><input id="Observaciones" name="Observaciones" value="@d.Observaciones" maxlength="300"/></div>}</div></section>
<section class="card document-section"><div class="section-heading"><h2>02 · Detalle de @(compra?"compra":"venta")</h2><span class="muted">@d.Detalle.Count variantes</span></div>
@if(!origen){<div class="line-entry"><div class="field variant-field"><label for="NuevaVariante">Variante</label><select id="NuevaVariante" name="NuevaVariante" data-suggest-price="@(!compra?"true":"false")"><option value="0">Selecciona una variante</option>@foreach(var v in Model.Variantes){<option value="@v.ProductoVarianteID" data-precio="@v.PrecioVentaActual.ToString(CultureInfo.InvariantCulture)" selected="@(v.ProductoVarianteID==d.NuevaVariante)">@v.Etiqueta</option>}</select></div><div class="field"><label for="NuevaCantidad">Cantidad</label><input id="NuevaCantidad" name="NuevaCantidad" type="number" min="0.0001" step="0.0001" value="@d.NuevaCantidad.ToString(CultureInfo.InvariantCulture)"/></div><div class="field"><label for="NuevoPrecio">@(compra?"Costo Q":"Precio Q")</label><input id="NuevoPrecio" name="NuevoPrecio" type="number" min="0" step="0.01" value="@d.NuevoPrecio.ToString(CultureInfo.InvariantCulture)"/></div><button class="button" type="submit" name="accion" value="Agregar" formnovalidate>+ Agregar</button></div>}
@if(d.Detalle.Count==0){<div class="empty compact"><span class="empty-symbol">+</span><h3>El detalle comienza aquí</h3><p>@(compra?"Selecciona un proveedor, carga sus variantes y agrega los productos de la orden.":"Selecciona una variante y la cantidad para agregarla al documento.")</p></div>}else{<div class="table-wrap"><table><thead><tr><th>Producto / variante</th><th>Cantidad</th><th>@(compra?"Costo":"Precio")</th><th>Subtotal</th>@if(!origen){<th>Acción</th>}</tr></thead><tbody>@for(int i=0;i<d.Detalle.Count;i++){var l=d.Detalle[i];<tr><td><strong>@l.Producto</strong><small>@l.CodigoSKU · @l.Presentacion · @(l.Color??"Sin color")</small><input type="hidden" name="Detalle[@i].ProductoVarianteID" value="@l.ProductoVarianteID"/></td><td>@l.Cantidad.ToString("0.####")<input type="hidden" name="Detalle[@i].Cantidad" value="@l.Cantidad.ToString(CultureInfo.InvariantCulture)"/></td><td>Q @l.PrecioUnitario.ToString("N2")<input type="hidden" name="Detalle[@i].PrecioUnitario" value="@l.PrecioUnitario.ToString(CultureInfo.InvariantCulture)"/></td><td>Q @l.Subtotal.ToString("N2")</td>@if(!origen){<td><button class="text-button" type="submit" name="accion" value="Quitar:@i" formnovalidate aria-label="Quitar @l.CodigoSKU">Quitar</button></td>}</tr>}</tbody></table></div>}</section></div>
<aside class="card order-summary"><span class="eyebrow">RESUMEN DEL DOCUMENTO</span><h2>Todo en orden.</h2><div class="summary-line"><span>Variantes</span><strong>@d.Detalle.Count</strong></div><div class="summary-line"><span>Subtotal</span><strong>Q @Fase2Servicio.Total(d.Detalle).ToString("N2")</strong></div><div class="grand-total"><span>Total</span><strong>Q @Fase2Servicio.Total(d.Detalle).ToString("N2")</strong></div><p>@(Model.Ruta=="Facturas"?"Al emitir, se actualizarán las existencias automáticamente.":compra?"El inventario se actualiza al registrar la recepción.":"Podrás confirmar y facturar esta cotización desde su detalle.")</p><button class="button primary full" type="submit" name="accion" value="Guardar" disabled="@(d.Detalle.Count==0)">@(Model.Ruta=="Facturas"?"Emitir factura":"Guardar documento")</button><a class="button full" href="/@Model.Ruta">Cancelar</a></aside></div></form>
