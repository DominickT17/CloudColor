@model DocumentosVm
@{ViewData["Title"]=Model.Titulo;}
<div class="page-heading"><div><span class="eyebrow">OPERACIONES CONECTADAS</span><h1>@Model.Titulo</h1><p>@Model.Descripcion</p></div>@if(Model.Crear){<a class="button primary" href="/@Model.Ruta/Nueva">+ @(Model.Ruta=="Compras"?"Nueva orden":Model.Ruta=="Facturas"?"Nueva factura":"Nueva cotización")</a>}</div>
@if(Model.Ruta=="Facturas"&&Model.Crear){<p class="helper-note spaced">Sin cotización previa, usa <a href="/Facturas/Nueva">Nueva factura</a> para seleccionar productos, revisar el importe y emitir en el momento. Si ya tienes una cotización confirmada, <a href="/Cotizaciones?estado=CONFIRMADA">factúrala desde Cotizaciones</a> para conservar sus precios.</p>}
<section class="card"><div class="card-toolbar"><form method="get" class="search"><input type="hidden" name="estado" value="@Context.Request.Query["estado"]"/><label for="buscar" class="sr-only">Buscar documento</label><input id="buscar" name="buscar" value="@Model.Buscar" maxlength="180" placeholder="Buscar número o nombre…"/><button class="button" type="submit">Buscar</button></form><span class="muted">@Model.Filas.Count documentos</span></div>
@if(Model.Filas.Count==0){<div class="empty"><span class="empty-symbol">▤</span><h2>Todo listo para tu próximo movimiento</h2><p>@(string.IsNullOrEmpty(Model.Buscar)&&string.IsNullOrEmpty(Context.Request.Query["estado"])?"Los documentos aparecerán aquí cuando registres la primera operación.":"No hay coincidencias. Ajusta o limpia los filtros para ver otros documentos.")</p>@if(Model.Crear){<a class="button primary" href="/@Model.Ruta/Nueva">Crear documento</a>}</div>}else{<div class="table-wrap"><table><thead><tr><th>Número</th><th>Cliente / proveedor</th><th>Fecha</th><th>Estado</th><th>Total</th><th>Acción</th></tr></thead><tbody>@foreach(var f in Model.Filas){<tr><td><strong>@f.Numero</strong></td><td>@f.Persona</td><td>@f.Fecha.ToString("dd MMM yyyy")</td><td><partial name="_Estado" model="f.Estado"/></td><td>@(f.Total.HasValue?"Q "+f.Total.Value.ToString("N2"):"—")</td><td><a class="text-button" href="/@(Model.Ruta=="Cobros"?"Cobros/Registrar":Model.Ruta+"/Ver")/@f.Id">@(Model.Ruta=="Cobros"?"Cobrar →":"Ver detalle →")</a></td></tr>}</tbody></table></div>}</section>
