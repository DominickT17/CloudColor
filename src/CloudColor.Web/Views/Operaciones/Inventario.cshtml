@model InventarioVm
@{ViewData["Title"]="Inventario";}
<div class="page-heading"><div><span class="eyebrow">VISIBILIDAD EN CADA UBICACIÓN</span><h1>Tu inventario, al día.</h1><p>Existencias por ingreso. El estado de stock considera el total de cada variante en todas las bodegas.</p></div><a class="button" href="/Recepciones">Registrar un ingreso →</a></div>
<div class="inventory-metrics"><section class="card metric"><span>Lotes en esta consulta</span><strong>@Model.Filas.Count</strong></section><section class="card metric"><span>Unidades disponibles</span><strong>@Model.Filas.Sum(x=>x.Lote.CantidadDisponible).ToString("N2")</strong></section><section class="card metric"><span>Variantes con stock bajo</span><strong>@Model.Filas.Where(x=>x.Estado=="Stock bajo").Select(x=>x.Lote.ProductoVarianteID).Distinct().Count()</strong></section></div>
<section class="card"><form method="get" class="inventory-filters"><div class="field"><label for="buscar">Producto o SKU</label><input id="buscar" name="buscar" value="@Model.Buscar" placeholder="Buscar producto…" maxlength="180"/></div><div class="field"><label for="variante">Variante</label><select id="variante" name="variante"><option value="">Todas las variantes</option>@foreach(var v in Model.Variantes){<option value="@v.ProductoVarianteID" selected="@(v.ProductoVarianteID==Model.Variante)">@v.Etiqueta</option>}</select></div><div class="field"><label for="bodega">Bodega</label><select id="bodega" name="bodega"><option value="">Todas las bodegas</option>@foreach(var x in Model.Bodegas){<option value="@x.BodegaID" selected="@(x.BodegaID==Model.Bodega)">@x.Nombre</option>}</select></div><div class="field"><label for="estado">Existencia de la variante</label><select id="estado" name="estado"><option value="">Todos los estados</option>@foreach(var e in new[]{"Sin stock","Stock bajo","Stock normal"}){<option selected="@(Model.Estado==e)">@e</option>}</select></div><button class="button primary" type="submit">Filtrar</button></form>
@if(Model.Filas.Count==0){<div class="empty"><span class="empty-symbol">▦</span><h2>No hay ingresos en esta consulta</h2><p>Registra una recepción de compra o ajusta los filtros.</p></div>}else{<div class="table-wrap"><table><thead><tr><th>Producto / SKU</th><th>Presentación / color</th><th>Bodega / ubicación</th><th>Lote</th><th>Ingreso</th><th>Disponible</th><th>Costo</th><th>Stock de variante</th></tr></thead><tbody>@foreach(var x in Model.Filas){var l=x.Lote;<tr><td><strong>@l.Producto</strong><small>@l.CodigoSKU</small></td><td>@l.Presentacion<small>@(l.Color??"Sin color")</small></td><td>@l.Bodega<small>@l.Ubicacion</small></td><td>@(l.NumeroLoteProveedor??"Sin lote proveedor")<small>Interno #@l.LoteInventarioID</small></td><td>@l.FechaIngreso.ToString("dd MMM yyyy")</td><td class="stock-number">@l.CantidadDisponible.ToString("0.####")</td><td>Q @l.CostoUnitario.ToString("N2")</td><td><span class="badge @(x.Estado=="Sin stock"?"red":x.Estado=="Stock bajo"?"amber":"green")">@x.Estado</span><small>Total @x.TotalVariante.ToString("0.####") · mínimo @x.Minimo.ToString("0.####")</small></td></tr>}</tbody></table></div>}</section>
