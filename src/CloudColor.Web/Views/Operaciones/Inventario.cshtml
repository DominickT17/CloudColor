@model InventarioVm
@{ViewData["Title"]="Inventario";string Filtro(string estado)=>Url.Action("Inventario",new{buscar=Model.Buscar,variante=Model.Variante,bodega=Model.Bodega,ubicacion=Model.Ubicacion,estado})!;}
<div class="page-heading"><div><span class="eyebrow">VISIBILIDAD EN CADA UBICACIÓN</span><h1>Tu inventario, al día.</h1><p>Stock por variante en todas las bodegas. El resumen incluye variantes sin ingresos.</p></div><a class="button" href="/Recepciones">Registrar un ingreso →</a></div>
<div class="metrics inventory-overview"><a class="card metric" href="/Variantes"><span>Total de variantes</span><strong>@Model.Variantes.Count</strong><small>Catálogo completo</small></a><a class="card metric" href="@Filtro("Stock bajo")"><span>Stock bajo</span><strong>@Model.StockBajo</strong><small>Existencia positiva menor al mínimo</small></a><a class="card metric" href="@Filtro("Sin stock")"><span>Sin stock</span><strong>@Model.SinStock</strong><small>Sin existencias o sin ingresos</small></a><a class="card metric" href="/Bodegas"><span>Bodegas activas</span><strong>@Model.Bodegas.Count(b=>b.Activo)</strong><small>Resumen global sin filtros</small></a></div>
<nav class="quick-filters" aria-label="Filtros rápidos de stock">@foreach(var estado in new[]{"","Disponible","Stock bajo","Sin stock"}){<a href="@Filtro(estado)" class="@(string.Equals(Model.Estado??"",estado,StringComparison.Ordinal)?"active":"")" aria-current="@(string.Equals(Model.Estado??"",estado,StringComparison.Ordinal)?"page":null)">@(estado==""?"Todos":estado)</a>}</nav>
<section class="card"><form method="get" class="inventory-filters"><div class="field"><label for="buscar">Producto o SKU</label><input id="buscar" name="buscar" value="@Model.Buscar" placeholder="Buscar producto…" maxlength="180"/></div><div class="field"><label for="variante">Variante</label><select id="variante" name="variante"><option value="">Todas las variantes</option>@foreach(var v in Model.Variantes){<option value="@v.ProductoVarianteID" selected="@(v.ProductoVarianteID==Model.Variante)">@v.Etiqueta</option>}</select></div><div class="field"><label for="bodega">Bodega</label><select id="bodega" name="bodega"><option value="">Todas las bodegas</option>@foreach(var x in Model.Bodegas){<option value="@x.BodegaID" selected="@(x.BodegaID==Model.Bodega)">@x.Nombre</option>}</select></div><div class="field"><label for="ubicacion">Ubicación</label><select id="ubicacion" name="ubicacion"><option value="">Todas las ubicaciones</option>@foreach(var x in Model.Ubicaciones){<option value="@x.UbicacionID" selected="@(x.UbicacionID==Model.Ubicacion)">@x.Etiqueta</option>}</select></div><div class="field"><label for="estado">Existencia de la variante</label><select id="estado" name="estado"><option value="">Todos los estados</option>@foreach(var e in new[]{"Disponible","Sin stock","Stock bajo","Stock normal"}){<option selected="@(Model.Estado==e)">@e</option>}</select></div><button class="button primary" type="submit">Filtrar</button></form>
<div class="inventory-result-note">@Model.Filas.Count lotes · @Model.Filas.Sum(x=>x.Lote.CantidadDisponible).ToString("N2") unidades en esta consulta. Stock bajo se compara con el total global de la variante.</div>
@if(Model.Filas.Count==0){<div class="empty"><span class="empty-symbol">▦</span><h2>No hay lotes en esta consulta</h2><p>Ajusta los filtros o registra una recepción. Las variantes que todavía no tienen ingresos se muestran por separado.</p><a class="button" href="/Recepciones">Consultar órdenes para recibir</a></div>}else{<div class="table-wrap"><table><thead><tr><th>Producto / SKU</th><th>Presentación / color</th><th>Bodega / ubicación</th><th>Lote</th><th>Ingreso</th><th>Disponible</th><th>Costo</th><th>Stock de variante</th></tr></thead><tbody>@foreach(var x in Model.Filas){var l=x.Lote;<tr><td><strong>@l.Producto</strong><small>@l.CodigoSKU</small></td><td>@l.Presentacion<small>@(l.Color??"Sin color")</small></td><td>@l.Bodega<small>@l.Ubicacion</small></td><td>@(l.NumeroLoteProveedor??"Sin lote proveedor")<small>Interno #@l.LoteInventarioID</small></td><td>@l.FechaIngreso.ToString("dd MMM yyyy")</td><td class="stock-number">@l.CantidadDisponible.ToString("0.####")</td><td>Q @l.CostoUnitario.ToString("N2")</td><td><span class="badge @(x.Estado=="Sin stock"?"red":x.Estado=="Stock bajo"?"amber":"green")">@x.Estado</span><small>Total @x.TotalVariante.ToString("0.####") · mínimo @x.Minimo.ToString("0.####")</small></td></tr>}</tbody></table></div>}</section>
@if(Model.SinIngresos.Count>0){<section class="card spaced"><div class="section-heading padded"><h2>Variantes sin ingresos</h2><span class="badge red">SIN STOCK</span></div><div class="no-stock-grid">@foreach(var v in Model.SinIngresos){<a href="/Variantes/Editar/@v.ProductoVarianteID"><strong>@v.Producto</strong><small>@v.CodigoSKU · @v.Presentacion · @(v.Color??"Sin color")</small><span>Sin ubicación ni lote asignados todavía.</span></a>}</div></section>}
