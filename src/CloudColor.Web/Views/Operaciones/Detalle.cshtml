@model DetalleDocumentoVm
@{
    var d = Model.Documento;
    ViewData["Title"] = d.Numero;
    var compra = Model.Ruta == "Compras";
    var factura = Model.Ruta == "Facturas";
    var anulada = factura && d.Estado == "ANULADA";
    var rolGerente = User.IsInRole("Gerente");
}
<a class="breadcrumb" href="/@Model.Ruta">← @Model.Ruta</a>
<div class="page-heading"><div><span class="eyebrow">@Model.Ruta.ToUpperInvariant()</span><h1>@d.Numero</h1><p>@d.Persona · @d.Fecha.ToString("dd MMM yyyy · HH:mm")</p></div>@if (anulada) { <span class="badge red" aria-label="Factura anulada">ANULADA</span> } else { <partial name="_Estado" model="d.Estado"/> }</div>
<div class="document-actions">
@if(Model.Ruta=="Cotizaciones"&&d.Estado=="PENDIENTE"){<form method="post" action="/Cotizaciones/Confirmar/@d.Id" data-confirm="¿Deseas confirmar la cotización @d.Numero? Una vez confirmada ya no podrás modificar sus líneas.">@Html.AntiForgeryToken()<button class="button primary" type="submit" data-confirm-title="Confirmar cotización">Confirmar cotización</button></form>}
@if(Model.Ruta=="Cotizaciones"&&d.Estado=="CONFIRMADA"){<a class="button primary" href="/Facturas/Nueva?cotizacion=@d.Id">Emitir factura desde cotización →</a>}
@if(compra&&d.Estado is "PENDIENTE" or "PARCIAL"){<a class="button primary" href="/Recepciones/Nueva/@d.Id">+ Registrar recepción</a>}
@if(factura){<a class="button" href="/Facturas/Imprimir/@d.Id" target="_blank" rel="noopener">Imprimir factura ↗</a>@if(!anulada&&d.Estado=="PENDIENTE_PAGO"&&(User.IsInRole("Gerente")||User.IsInRole("Cajero"))){<a class="button primary" href="/Cobros/Registrar/@d.Id">Registrar cobro →</a>}@if(!anulada&&rolGerente){<a class="button" href="/Devoluciones/Nueva?factura=@d.Id">Registrar devolución</a><button class="button danger" type="button" data-open-dialog="anular-factura">Anular factura</button>}}
</div>
@if(factura && anulada){<section class="card spaced cancellation-notice"><h2>Factura anulada</h2><p>El historial y los pagos se conservan. El importe actual de la factura es <strong>Q 0.00</strong>.</p></section>}
@if(compra){decimal solicitado=Model.Compra.Sum(x=>x.CantidadSolicitada),recibido=Model.Compra.Sum(x=>x.CantidadRecibida);<section class="card progress-card" data-progress-key="compra-@d.Id"><div><span class="eyebrow">PROGRESO DE RECEPCIÓN</span><h2>@recibido.ToString("0.####") / @solicitado.ToString("0.####") recibidos</h2><p class="muted">@((solicitado-recibido).ToString("0.####")) pendientes · @(solicitado>0?decimal.Round(recibido/solicitado*100,1):0)% recibido</p></div><progress max="@solicitado.ToString(CultureInfo.InvariantCulture)" value="@recibido.ToString(CultureInfo.InvariantCulture)" aria-label="Cantidades recibidas de la orden"></progress></section>}
<section class="card"><div class="section-heading padded"><h2>@(factura?"Detalle de la venta":compra?"Detalle de la orden":"Detalle de la cotización")</h2><span class="muted">@(compra?Model.Compra.Count:Model.Venta.Count) variantes</span></div><div class="table-wrap"><table><thead><tr><th>Producto / variante</th><th>@(compra?"Solicitado":"Cantidad")</th><th>@(compra?"Costo acordado":"Precio unitario")</th>@if(compra){<th>Recibido</th><th>Pendiente</th>}else{<th>Subtotal histórico</th>}</tr></thead><tbody>
@if(compra){@foreach(var l in Model.Compra){<tr><td><strong>@l.Producto</strong><small>@l.CodigoSKU · @l.Presentacion · @(l.Color??"Sin color")</small></td><td>@l.CantidadSolicitada.ToString("0.####")</td><td>Q @l.CostoUnitarioOrden.ToString("N2")</td><td>@l.CantidadRecibida.ToString("0.####")</td><td><strong>@l.CantidadPendiente.ToString("0.####")</strong></td></tr>}}
else{@foreach(var l in Model.Venta){<tr><td><strong>@l.Producto</strong><small>@l.CodigoSKU · @l.Presentacion · @(l.Color??"Sin color")</small></td><td>@l.Cantidad.ToString("0.####")</td><td>Q @l.PrecioUnitario.ToString("N2")</td><td><strong>Q @l.Subtotal.ToString("N2")</strong></td></tr>}}
</tbody></table></div>@if(d.Total.HasValue){<div class="detail-total"><span>@(factura?"Total actual":"Total del documento")</span><strong>Q @d.Total.Value.ToString("N2")</strong></div>@if(factura&&Model.TotalOriginal.HasValue&&Model.TotalOriginal.Value!=d.Total.Value){<div class="detail-total"><span>Total original conservado</span><strong>Q @Model.TotalOriginal.Value.ToString("N2")</strong></div>}}</section>
@if(factura){<section class="card activity"><div class="section-heading padded"><div><h2>Factura y cobros</h2><p class="muted">Cliente: @d.Persona · NIT: @(Model.NIT??"Sin NIT")</p></div><span>Empleado: @Model.Emisor · Usuario emisor: @Model.UsuarioEmisor</span></div>@if(!anulada){<p class="muted spaced">Saldo por cobrar: <strong>Q @Math.Max(0,d.Total.GetValueOrDefault()-Model.Pagos.Sum(p=>p.Monto)).ToString("N2")</strong></p>}
@if(Model.Pagos.Count==0){<div class="empty compact"><p>No hay pagos registrados.</p></div>}else{<div class="table-wrap"><table><thead><tr><th>Medio</th><th>Referencia</th><th>Monto</th><th>Fecha</th><th>Cajero</th></tr></thead><tbody>@foreach(var p in Model.Pagos){<tr><td>@p.Medio</td><td>@(p.Referencia??"—")</td><td>Q @p.Monto.ToString("N2")</td><td>@p.FechaHora?.ToString("dd MMM yyyy · HH:mm")</td><td>@p.Cajero</td></tr>}</tbody></table></div>}</section>
@if(rolGerente&&Model.Lotes is {Count:>0}){<section class="card activity"><div class="section-heading padded"><div><h2>Lotes e inventario de origen</h2><p class="muted">Trazabilidad para revisión y restitución de existencias.</p></div></div><div class="table-wrap"><table><thead><tr><th>Producto / SKU</th><th>Lote</th><th>Fecha ingreso</th><th>Bodega / ubicación</th><th>Salida</th><th>Devuelta</th><th>Neto</th></tr></thead><tbody>@foreach(var l in Model.Lotes){<tr><td>@l.Producto<small>@l.CodigoSKU · @l.Presentacion · @(l.Color??"Sin color")</small></td><td>@(l.NumeroLoteProveedor??"Sin lote proveedor")</td><td>@l.FechaIngreso.ToString("dd MMM yyyy")</td><td>@l.Bodega · @l.Ubicacion</td><td>@l.CantidadSalida.ToString("0.####")</td><td>@l.CantidadDevuelta.ToString("0.####")</td><td>@l.CantidadNeta.ToString("0.####")</td></tr>}</tbody></table></div></section>}
@if(rolGerente&&!anulada){<dialog id="anular-factura" aria-labelledby="anular-factura-titulo" aria-describedby="anular-factura-ayuda"><form method="post" action="/Facturas/Anular/@d.Id">@Html.AntiForgeryToken()<h2 id="anular-factura-titulo">Anular @d.Numero</h2><p id="anular-factura-ayuda">Se conservará la factura, se registrará el motivo y se restituirá lo que permanezca vendido a los lotes originales.</p><label class="field spaced"><span>Motivo obligatorio</span><textarea name="motivo" maxlength="300" minlength="5" rows="4" required placeholder="Describe el motivo de la anulación"></textarea></label><div class="form-actions"><button class="button" type="button" data-close-dialog>Volver</button><button class="button danger" type="submit">Confirmar anulación</button></div></form></dialog>}
}
@if(compra){<section class="card activity"><div class="section-heading padded"><h2>Historial de recepciones</h2></div>@if(Model.Recepciones.Count==0){<div class="empty compact"><p>La orden todavía no registra entregas.</p></div>}else{<div class="table-wrap"><table><thead><tr><th>Recepción</th><th>Variante</th><th>Ingreso</th><th>Cantidad</th><th>Costo real</th><th>Ubicación</th><th>Lote proveedor</th></tr></thead><tbody>@foreach(var r in Model.Recepciones){<tr><td><a href="/Recepciones/Detalle/@r.RecepcionCompraID?orden=@d.Id">@r.NumeroRecepcion</a></td><td>@Model.Compra.FirstOrDefault(x=>x.DetalleOrdenCompraID==r.DetalleOrdenCompraID)?.CodigoSKU</td><td>@r.FechaIngreso.ToString("dd MMM yyyy")</td><td>@r.CantidadRecibida.ToString("0.####")</td><td>Q @r.CostoUnitario.ToString("N2")</td><td>@r.Ubicacion</td><td>@(r.NumeroLoteProveedor??"Sin lote proveedor")</td></tr>}</tbody></table></div>}</section>}
@if(Model.Ruta=="Cotizaciones"&&d.Estado=="FACTURADA"){<section class="card spaced"><p>Esta cotización ya generó una factura. <a href="/Facturas?buscar=@Uri.EscapeDataString(d.Numero)">Busca la factura asociada</a>.</p></section>}
