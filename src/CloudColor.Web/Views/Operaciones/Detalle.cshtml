@model DetalleDocumentoVm
@{var d=Model.Documento;ViewData["Title"]=d.Numero;bool compra=Model.Ruta=="Compras";}
<a class="breadcrumb" href="/@Model.Ruta">← @Model.Ruta</a><div class="page-heading"><div><span class="eyebrow">@Model.Ruta.ToUpperInvariant()</span><h1>@d.Numero</h1><p>@d.Persona · @d.Fecha.ToString("dd MMM yyyy · HH:mm")</p></div><partial name="_Estado" model="d.Estado"/></div>
<div class="document-actions">
@if(Model.Ruta=="Cotizaciones"&&d.Estado=="PENDIENTE"){<form method="post" action="/Cotizaciones/Confirmar/@d.Id" data-confirm="¿Confirmar esta cotización para permitir su facturación?">@Html.AntiForgeryToken()<button class="button primary" type="submit">Confirmar cotización</button></form>}
@if(Model.Ruta=="Cotizaciones"&&d.Estado=="CONFIRMADA"){<a class="button primary" href="/Facturas/Nueva?cotizacion=@d.Id">Facturar cotización →</a>}
@if(compra&&d.Estado is "PENDIENTE" or "PARCIAL"){<a class="button primary" href="/Recepciones/Nueva/@d.Id">+ Registrar recepción</a>}
@if(Model.Ruta=="Facturas"){<a class="button" href="/Facturas/Imprimir/@d.Id" target="_blank" rel="noopener">Vista de impresión ↗</a>@if(d.Estado=="PENDIENTE_PAGO"&&(User.IsInRole("Gerente")||User.IsInRole("Cajero"))){<a class="button primary" href="/Cobros/Registrar/@d.Id">Registrar cobro →</a>}}
</div>
@if(compra){decimal solicitado=Model.Compra.Sum(x=>x.CantidadSolicitada),recibido=Model.Compra.Sum(x=>x.CantidadRecibida);<section class="card progress-card"><div><span class="eyebrow">PROGRESO DE RECEPCIÓN</span><h2>@recibido.ToString("0.####") / @solicitado.ToString("0.####") recibidos</h2><p class="muted">@((solicitado-recibido).ToString("0.####")) pendientes · @(solicitado>0?decimal.Round(recibido/solicitado*100,1):0)% recibido</p></div><progress max="@solicitado.ToString(CultureInfo.InvariantCulture)" value="@recibido.ToString(CultureInfo.InvariantCulture)" aria-label="Cantidades recibidas de la orden"></progress></section>}
<section class="card"><div class="section-heading padded"><h2>Detalle del documento</h2><span class="muted">@(compra?Model.Compra.Count:Model.Venta.Count) variantes</span></div><div class="table-wrap"><table><thead><tr><th>Producto / variante</th><th>@(compra?"Solicitado":"Cantidad")</th><th>@(compra?"Costo acordado":"Precio unitario")</th>@if(compra){<th>Recibido</th><th>Pendiente</th>}else{<th>Subtotal</th>}</tr></thead><tbody>
@if(compra){@foreach(var l in Model.Compra){<tr><td><strong>@l.Producto</strong><small>@l.CodigoSKU · @l.Presentacion · @(l.Color??"Sin color")</small></td><td>@l.CantidadSolicitada.ToString("0.####")</td><td>Q @l.CostoUnitarioOrden.ToString("N2")</td><td>@l.CantidadRecibida.ToString("0.####")</td><td><strong>@l.CantidadPendiente.ToString("0.####")</strong></td></tr>}}
else{@foreach(var l in Model.Venta){<tr><td><strong>@l.Producto</strong><small>@l.CodigoSKU · @l.Presentacion · @(l.Color??"Sin color")</small></td><td>@l.Cantidad.ToString("0.####")</td><td>Q @l.PrecioUnitario.ToString("N2")</td><td><strong>Q @l.Subtotal.ToString("N2")</strong></td></tr>}}
</tbody></table></div>@if(d.Total.HasValue){<div class="detail-total"><span>Total del documento</span><strong>Q @d.Total.Value.ToString("N2")</strong></div>}</section>
@if(compra){<section class="card activity"><div class="section-heading padded"><h2>Historial de recepciones</h2></div>@if(Model.Recepciones.Count==0){<div class="empty compact"><p>La orden todavía no registra entregas.</p></div>}else{<div class="table-wrap"><table><thead><tr><th>Recepción</th><th>Variante</th><th>Ingreso</th><th>Cantidad</th><th>Costo real</th><th>Ubicación</th><th>Lote proveedor</th></tr></thead><tbody>@foreach(var r in Model.Recepciones){<tr><td><a href="/Recepciones/Detalle/@r.RecepcionCompraID?orden=@d.Id">@r.NumeroRecepcion</a></td><td>@Model.Compra.FirstOrDefault(x=>x.DetalleOrdenCompraID==r.DetalleOrdenCompraID)?.CodigoSKU</td><td>@r.FechaIngreso.ToString("dd MMM yyyy")</td><td>@r.CantidadRecibida.ToString("0.####")</td><td>Q @r.CostoUnitario.ToString("N2")</td><td>@r.Ubicacion</td><td>@(r.NumeroLoteProveedor??"Sin lote proveedor")</td></tr>}</tbody></table></div>}</section>}
@if(Model.Ruta=="Facturas"){<section class="card activity"><div class="section-heading padded"><h2>Medios de pago</h2><span class="muted">Emisor: @Model.Emisor</span></div>@if(Model.Pagos.Count==0){<div class="empty compact"><p>No hay pagos registrados.</p></div>}else{<div class="table-wrap"><table><thead><tr><th>Medio</th><th>Referencia</th><th>Monto</th><th>Fecha</th></tr></thead><tbody>@foreach(var p in Model.Pagos){<tr><td>@p.Medio</td><td>@(p.Referencia??"—")</td><td>Q @p.Monto.ToString("N2")</td><td>@p.FechaHora?.ToString("dd MMM yyyy · HH:mm")</td></tr>}</tbody></table></div>}</section>}
