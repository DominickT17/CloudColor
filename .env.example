# Copie este archivo a .env y complete todos los valores antes de usar Compose.
# SQL: minimo 8 caracteres y tres de estas categorias: mayusculas, minusculas,
# digitos y simbolos. Para esta configuracion use solo letras, numeros y _!#%+@-
# (evita ambiguedades en la cadena de conexion y la interpolacion de Compose).
MSSQL_SA_PASSWORD=
CLOUDCOLOR_GERENTE_CODIGO=
CLOUDCOLOR_GERENTE_NOMBRES=
CLOUDCOLOR_GERENTE_APELLIDOS=
CLOUDCOLOR_GERENTE_USUARIO=
# La aplicacion exige entre 12 y 128 caracteres; use comillas simples en .env
# para conservar literalmente los signos especiales, por ejemplo el signo dolar.
CLOUDCOLOR_GERENTE_PASSWORD=
CLOUDCOLOR_DIGITADOR_CODIGO=
CLOUDCOLOR_DIGITADOR_NOMBRES=
CLOUDCOLOR_DIGITADOR_APELLIDOS=
CLOUDCOLOR_DIGITADOR_USUARIO=
CLOUDCOLOR_DIGITADOR_PASSWORD=
CLOUDCOLOR_CAJERO_CODIGO=
CLOUDCOLOR_CAJERO_NOMBRES=
CLOUDCOLOR_CAJERO_APELLIDOS=
CLOUDCOLOR_CAJERO_USUARIO=
CLOUDCOLOR_CAJERO_PASSWORD=
CLOUDCOLOR_WEB_PORT=8080
